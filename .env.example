# HemTra — mẫu biến môi trường. Copy thành `.env.local` rồi điền giá trị thật.
# KHÔNG commit file chứa secret. Frontend (Vite) chỉ đọc biến VITE_* công khai.

# --- Public (được phép lộ ra browser) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# --- Server / CLI only (TUYỆT ĐỐI không đặt tiền tố VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-chi-dung-edge-function>
SUPABASE_ACCESS_TOKEN=<scoped-token-cho-cli-mcp>
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=<db-password-cho-supabase-db-push>

# --- P3 (hỏi user khi tới phase, chưa có thì để trống) ---
BOOTSTRAP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_APP_PASSWORD=